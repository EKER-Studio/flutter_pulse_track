<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include app data files, database, and preferences for Android 6.0 - 11 -->
    <include domain="file" path="app_flutter" />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <!-- Exclude active Isar lock file and hardware-bound secure storage -->
    <exclude domain="file" path="app_flutter/default.isar.lock" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
